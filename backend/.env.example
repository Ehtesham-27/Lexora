# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or local)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lexora

# Authentication JWT Secret (min 32 characters recommended)
JWT_SECRET=lexora_super_secret_jwt_key_change_in_production_min_32_chars

# Frontend Client Origin (for CORS and cookie authorization)
FRONTEND_URL=http://localhost:5173

# External Dictionary API Provider
DICTIONARY_API_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# Word Cache TTL in days
CACHE_TTL_DAYS=30

